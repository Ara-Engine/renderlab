// Project each local vertex once, preserving the raster's two matrix association.
// Indirect dispatch is generated by finish after each phase's cull.
@group(0) @binding(3) var<storage,read> lists:array<u32>;
@group(0) @binding(5) var<storage,read> args:array<u32>;
@group(0) @binding(9) var projected:texture_storage_2d<rgba32float,write>;
@group(2) @binding(8) var<storage,read> cluster_data:binding_array<U32s,PRIMARY_BATCHES>;
@compute @workgroup_size(128) fn project(@builtin(workgroup_id) group:vec3<u32>,@builtin(local_invocation_index) local:u32) {
    let instance=group.x+group.y*65535u;
    if instance>=args[5] {return;}
    let index=lists[config.info.x+instance];
    let c=clusters[index];
    if local>=((c.counts>>8u)&255u) {return;}
    let batch=placements[c.placement]&0x1fffffffu;
    let o=c.vertices+3u*local;let d=&cluster_data[batch].data;
    let p=vec3<f32>(bitcast<f32>((*d)[o]),bitcast<f32>((*d)[o+1u]),bitcast<f32>((*d)[o+2u]));
    let clip=config.matrix*(models[c.placement]*vec4<f32>(p,1.0));
    let at=c.pad1+local;
    textureStore(projected,vec2<i32>(i32(at&1023u),i32(at>>10u)),clip);
}
